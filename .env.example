# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Stripe (Premium) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_PRICE_ID=

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FIREPath

# === Analytics ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Monetization — Programmatic Ad Provider ===
# Which single programmatic network loads. Exactly ONE may be active at a time.
# Options: adsense | ezoic | raptive | none. Default (unset): adsense.
# Example: NEXT_PUBLIC_AD_PROVIDER=adsense
NEXT_PUBLIC_AD_PROVIDER=

# === Ads (Google AdSense — freemium: free tier sees ads, premium is ad-free) ===
# Full publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX. When unset, no ads load and
# ads.txt is empty (the free build keeps working).
# Example: NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Optional per-surface ad unit slot ids (numeric, from the AdSense dashboard).
# Leave blank to let AdSense auto-size.
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=

# === Ezoic (set NEXT_PUBLIC_AD_PROVIDER=ezoic to activate) ===
# Set to "true" to enable Ezoic loader injection.
# Example: NEXT_PUBLIC_EZOIC_ENABLED=true
NEXT_PUBLIC_EZOIC_ENABLED=
# Your Ezoic site id (from the Ezoic dashboard).
# Example: NEXT_PUBLIC_EZOIC_SITE_ID=12345
NEXT_PUBLIC_EZOIC_SITE_ID=

# === Raptive (set NEXT_PUBLIC_AD_PROVIDER=raptive to activate) ===
# Your Raptive site id (from the Raptive dashboard).
# Example: NEXT_PUBLIC_RAPTIVE_SITE_ID=your-site-name
NEXT_PUBLIC_RAPTIVE_SITE_ID=

# === ads.txt redirect (for Ezoic / Raptive ads.txt managers) ===
# When set, /ads.txt 301-redirects here so the provider serves the combined file.
# Leave unset to serve the default AdSense line from this app.
# Example: NEXT_PUBLIC_ADSTXT_REDIRECT_URL=https://srv.adstxtmanager.com/19168/yoursite.com
NEXT_PUBLIC_ADSTXT_REDIRECT_URL=

# === Monetization — Primary Intent CTA ===
# Type of primary call-to-action shown below FIRE results.
# Options: call | cpl | affiliate | none. Default (unset): cpl (project default).
# Example: NEXT_PUBLIC_PRIMARY_CTA_TYPE=cpl
NEXT_PUBLIC_PRIMARY_CTA_TYPE=

# "call" type — tel: button for PPC phone traffic.
# Example: NEXT_PUBLIC_PPC_NUMBER=+18005550100
NEXT_PUBLIC_PPC_NUMBER=
# Example: NEXT_PUBLIC_PPC_LABEL=Speak with a licensed advisor
NEXT_PUBLIC_PPC_LABEL=

# "cpl" type — outbound link to advertiser-hosted lead form (TCPA = advertiser's).
# Example: NEXT_PUBLIC_CPL_URL=https://partner.example.com/advisor-match
NEXT_PUBLIC_CPL_URL=
# Example: NEXT_PUBLIC_CPL_LABEL=Find a fee-only financial advisor
NEXT_PUBLIC_CPL_LABEL=

# === Monetization — Featured Partner Table ===
# JSON array of {label, figure, href} objects (3–5 rows recommended).
# When empty or unset, the entire table AND the FTC disclosure are hidden.
# Example: MON_FEATURED_PARTNERS=[{"label":"Acme Robo","figure":"0.25% AUM","href":"https://acme.example.com"}]
MON_FEATURED_PARTNERS=

# === Monetization — Sponsor Slot ===
# Rich HTML block (owner-supplied, rendered as-is). Shown with "Sponsored" label.
# Example: NEXT_PUBLIC_SPONSOR_HTML=<a href="https://sponsor.example.com">Sponsor name — tagline</a>
NEXT_PUBLIC_SPONSOR_HTML=
# CPA backfill link shown when NEXT_PUBLIC_SPONSOR_HTML is unset.
# Example: NEXT_PUBLIC_SPONSOR_BACKFILL_URL=https://cpa.example.com/firepath
NEXT_PUBLIC_SPONSOR_BACKFILL_URL=

# === Monetization — Email Capture ===
# Set to "on" to show the email capture form below FIRE results.
# Default (unset): off (form hidden). Uses existing /api/subscribe route.
# Example: NEXT_PUBLIC_EMAIL_CAPTURE=on
NEXT_PUBLIC_EMAIL_CAPTURE=
# CAN-SPAM REQUIREMENT: a physical postal address is legally required on any
# commercial email-collection form. The email capture form renders ONLY when
# BOTH NEXT_PUBLIC_EMAIL_CAPTURE=on AND this address are set — leaving this
# blank hides the form even if NEXT_PUBLIC_EMAIL_CAPTURE=on.
# Example: NEXT_PUBLIC_POSTAL_ADDRESS=123 Main St, Suite 100, Wilmington, DE 19801
NEXT_PUBLIC_POSTAL_ADDRESS=

# === Monetization — Auto-Affiliate ===
# Sovrn or Skimlinks id for automated affiliate link injection on unsponsored links.
# Only applies to links without a direct deal. Leave blank when not using.
# Example: NEXT_PUBLIC_AUTOAFFILIATE=sovrn:1234567
NEXT_PUBLIC_AUTOAFFILIATE=

# === Affiliate CTA (legacy — superseded by NEXT_PUBLIC_PRIMARY_CTA_TYPE=cpl) ===
# Still honoured by the existing AdvisorCta component on /fire-types, /healthcare-bridge.
NEXT_PUBLIC_ADVISOR_CTA_URL=
NEXT_PUBLIC_ADVISOR_CTA_LABEL=
NEXT_PUBLIC_ADVISOR_CTA_CONTEXT=
