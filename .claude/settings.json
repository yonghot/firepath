{
  "hooks": {
    "session-init": {
      "command": "bash .claude/hooks/session-init.sh",
      "description": "Initialize session: check env, show progress"
    },
    "pre-commit": {
      "command": "bash .claude/hooks/pre-commit-gate.sh",
      "description": "Pre-commit gate: lint + typecheck + impeccable --fast"
    },
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"grep -rnE 'from-purple-|to-blue-|hover:scale-105|#000000' src/ >/dev/null 2>&1 && { echo 'Anti-slop violation in src/. See design/forbidden.md' >&2; exit 2; }; exit 0\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"npx impeccable detect src/ --json > .slop.json 2>/dev/null || true\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(cd *)"
    ]
  }
}
